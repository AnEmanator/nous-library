{
    "singleQuote": true,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "trailingComma": "none",
    "printWidth": 120,
    "endOfLine": "lf",
    "arrowParens": "avoid",
    "quoteProps": "as-needed",
    "overrides": [
        {
            "files": ["*.json", ".prettierrc", "*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
